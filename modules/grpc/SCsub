#!/usr/bin/env python
from misc.utility.scons_hints import *

Import("env")
Import("env_modules")

env_grpc = env_modules.Clone()

# Vendored nghttp2 (HTTP/2 framing, HPACK, flow control). MIT licensed.
env_grpc.Prepend(CPPPATH=["#thirdparty/nghttp2/include", "#thirdparty/nghttp2/lib"])
env_grpc.Append(CPPDEFINES=["NGHTTP2_STATICLIB"])

env_grpc.add_source_files(env.modules_sources, "*.cpp")
env_grpc.add_source_files(env.modules_sources, "proto/*.cpp")

env_nghttp2 = env_modules.Clone()
env_nghttp2.Prepend(CPPPATH=["#thirdparty/nghttp2/include", "#thirdparty/nghttp2/lib"])
env_nghttp2.Append(CPPDEFINES=["NGHTTP2_STATICLIB"])
env_nghttp2.disable_warnings()
env_nghttp2.add_source_files(env.modules_sources, "#thirdparty/nghttp2/lib/*.c")

if env["tests"]:
    env_grpc.add_source_files(env.modules_sources, "./tests/*.cpp")
